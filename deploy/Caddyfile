# Caddy automatically obtains and renews a Let's Encrypt certificate for it,
# which satisfies Tesla's "domain registered with a certificate authority" rule.

tesla-amp.duckdns.org {
	handle /chat* {
		reverse_proxy api:8000
	}
	handle /vehicle/* {
		reverse_proxy api:8000
	}
	handle /auth/* {
		reverse_proxy api:8000
	}
	handle /.well-known/* {
		reverse_proxy api:8000
	}
	handle /health* {
		reverse_proxy api:8000
	}
	# Scheduled-action queue behind the sidebar. Every backend path needs an
	# entry here — anything unlisted falls through to the catch-all below and
	# is answered by the static frontend with a confusing nginx 404.
	handle /jobs* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy frontend:80
	}
}
