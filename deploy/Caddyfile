# Caddy automatically obtains and renews a Let's Encrypt certificate for it,
# which satisfies Tesla's "domain registered with a certificate authority" rule.

tesla-amp.duckdns.org {
	# Access control lives in the API (backend/app/auth/gate.py), not here.
	#
	# This site briefly carried HTTP basic auth as scaffolding, added the
	# moment we realised anyone with the URL could unlock the car — the
	# hostname is not a secret, Let's Encrypt publishes it to Certificate
	# Transparency logs. It was removed once the in-app passcode gate was
	# verified, because two prompts for one person is friction without
	# benefit: the gate is enforced by the API itself, so it also holds if
	# something ever reaches the backend without passing through Caddy
	# (verified from inside the compose network).

	# Passcode gate (see backend/app/auth/gate.py). Without this entry the
	# unlock request falls through to the static frontend and comes back as
	# an nginx 404 — the app looks broken rather than locked.
	handle /gate/* {
		reverse_proxy api:8000
	}
	# Confirmation of physically consequential commands (unlock, trunk,
	# HomeLink). The assistant can only propose those; this is the path the
	# owner's tap travels to actually execute one.
	handle /actions/* {
		reverse_proxy api:8000
	}
	# The trailing * is load-bearing, not decoration: /chat/pending/{id} is how
	# the app collects a turn that had to wait for the car to wake (see
	# backend/app/turns.py), and it is routed here only because this pattern is
	# a prefix match. Narrowed to a bare /chat, the poll falls through to the
	# catch-all below and every reply that woke the car is answered by nginx's
	# 404 — the app would show the "waking it now" line and then nothing, which
	# is a worse version of the silence this was built to remove.
	handle /chat* {
		reverse_proxy api:8000
	}
	# Speech to text, and the single-question endpoint an Apple Shortcut calls.
	# The body cap is enforced here as well as in the app: the API checks the
	# size only after Starlette has read the request, so without this a large
	# upload is buffered in a container that has ~1 GB to lose.
	handle /voice/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8000
	}
	# The tool calls a live audio session makes. The conversation itself runs
	# between the phone and Google; this is where it reaches the car, and it
	# reaches it through the same dispatch and the same confirmation gate as
	# the typed assistant.
	handle /live/* {
		reverse_proxy api:8000
	}
	handle /vehicle/* {
		reverse_proxy api:8000
	}
	handle /auth/* {
		reverse_proxy api:8000
	}
	# Tesla fetches the virtual-key public key from here itself, so this one
	# path must stay reachable without credentials (see @protected above).
	handle /.well-known/* {
		reverse_proxy api:8000
	}
	handle /health* {
		reverse_proxy api:8000
	}
	# Scheduled-action queue behind the sidebar. Every backend path needs an
	# entry here — anything unlisted falls through to the catch-all below and
	# is answered by the static frontend with a confusing nginx 404.
	handle /jobs* {
		reverse_proxy api:8000
	}
	# Which built-in manners the settings screen may offer. Read-only and tiny,
	# but it needs an entry like everything else: without one it falls to the
	# catch-all and the picker silently keeps the list it shipped with.
	handle /personas* {
		reverse_proxy api:8000
	}
	# --- how long the browser may keep the app -----------------------------
	#
	# Nothing said anything about caching before this, and "nothing" is not the
	# same as "don't cache": with only an ETag and a Last-Modified to go on, a
	# browser falls back to heuristic freshness — commonly a tenth of the file's
	# age — so the longer a build sat deployed, the longer a phone was entitled
	# to keep serving it without ever asking. That is the whole of why a deploy
	# did not reach an installed PWA.
	#
	# The asset names carry a hash of their own contents, so they can be kept
	# for as long as a browser likes: a changed file is a different name, and
	# the old name is never requested again.
	@hashed path /_expo/static/* /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# And the handful of files that are fetched by a fixed name have to be
	# re-read, or nothing above is ever noticed. "no-cache" is not "no-store":
	# the copy is kept and revalidated, so the usual answer is a 304 costing a
	# few hundred bytes, not a fresh download of the app.
	@byname path / /index.html /manifest.json /favicon.ico /apple-touch-icon.png /icons/*
	header @byname Cache-Control "no-cache"

	handle {
		reverse_proxy frontend:80
	}
}
