# --- LLM (the AI chat layer) ---
# Which provider to use: gemini (default) or anthropic
LLM_PROVIDER=gemini

# Google Gemini — get a key at https://aistudio.google.com/apikey
# Do NOT commit the real value.
GEMINI_API_KEY=
# gemini-3.5-flash-lite: free-tier daily quota is ~500 requests/day, vs.
# only 20/day on gemini-3.6-flash — Google throttles free access hardest on
# its newest models. Check your exact current limit at
# https://aistudio.google.com/rate-limit. Other verified-working options:
# gemini-3.5-flash, gemini-3.6-flash, gemini-flash-latest (alias that
# auto-tracks the newest Flash — but inherits whatever quota that carries).
# Don't use gemini-2.5-flash or older — retired, returns 404 even though it
# still appears in models.list().
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Tesla adapter selection ---
# mock   -> no car, no Tesla account needed (default for local dev)
# fleet  -> real Tesla Fleet API + self-hosted signing proxy
TESLA_ADAPTER=mock

# --- Tesla Fleet API (only needed when TESLA_ADAPTER=fleet) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# The public origin you registered with Tesla, e.g. https://volt.duckdns.org
TESLA_APP_DOMAIN=
# Where Tesla sends the user back after OAuth. Must match the developer portal exactly.
TESLA_REDIRECT_URI=https://volt.duckdns.org/auth/callback
# Base URL of the local vehicle-command signing proxy (see deploy/docker-compose.yml)
TESLA_PROXY_URL=https://tesla-proxy:4443
# Fleet API region host: na  = https://fleet-api.prd.na.vn.cloud.tesla.com
#                        eu  = https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_FLEET_BASE=https://fleet-api.prd.eu.vn.cloud.tesla.com

# --- Voice ---
# Speech-to-text runs on Gemini regardless of LLM_PROVIDER (Anthropic takes no
# audio), so GEMINI_API_KEY above must be set for the microphone to work even
# when the assistant itself runs on Claude. By default transcription reuses
# GEMINI_MODEL; set this only if that model ever stops accepting audio.
GEMINI_TRANSCRIBE_MODEL=

# Bearer token for the Apple Shortcut ("Hey Siri, Amp"). Leave EMPTY to keep
# the feature off — with no value set, no token is accepted at all and the
# session cookie stays the only way in.
#
# Generate with:  openssl rand -hex 32
# Anything shorter than 32 characters is ignored, with a warning in the logs.
#
# It reaches exactly one endpoint, POST /voice/ask — asking questions and
# starting reversible things. It cannot confirm a command that moves the car;
# that still needs a tap in the app. Revoke by changing this and restarting.
AMP_SHORTCUT_TOKEN=

# --- App ---
# Comma-separated origins allowed to call this API (your mobile app in dev).
CORS_ORIGINS=*
