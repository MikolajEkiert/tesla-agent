# --- LLM (the AI chat layer) ---
# Which provider to use: gemini (default) or anthropic
LLM_PROVIDER=gemini

# Google Gemini — get a key at https://aistudio.google.com/apikey
# Do NOT commit the real value.
GEMINI_API_KEY=
# gemini-2.5-flash is fast and generous on the free tier — good for voice.
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Tesla adapter selection ---
# mock   -> no car, no Tesla account needed (default for local dev)
# fleet  -> real Tesla Fleet API + self-hosted signing proxy
TESLA_ADAPTER=mock

# --- Tesla Fleet API (only needed when TESLA_ADAPTER=fleet) ---
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
# The public origin you registered with Tesla, e.g. https://volt.duckdns.org
TESLA_APP_DOMAIN=
# Where Tesla sends the user back after OAuth. Must match the developer portal exactly.
TESLA_REDIRECT_URI=https://volt.duckdns.org/auth/callback
# Base URL of the local vehicle-command signing proxy (see deploy/docker-compose.yml)
TESLA_PROXY_URL=https://tesla-proxy:4443
# Fleet API region host: na  = https://fleet-api.prd.na.vn.cloud.tesla.com
#                        eu  = https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_FLEET_BASE=https://fleet-api.prd.eu.vn.cloud.tesla.com

# --- App ---
# Comma-separated origins allowed to call this API (your mobile app in dev).
CORS_ORIGINS=*
